{
  "name": "Redirect Chain Analyzer — CROSX",
  "short_name": "Redirect Analyzer",
  "description": "Trace any URL end to end: HTTP 301/302/307/308 redirects, meta refresh, obfuscated JavaScript navigation, cloaked affiliate hops, loops and tracking parameter loss.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "theme_color": "#131313",
  "background_color": "#131313",
  "categories": ["utilities", "developer", "productivity", "security"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Analyze a URL",
      "short_name": "Analyze",
      "description": "Open the analyzer and trace a new redirect chain",
      "url": "/?source=shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Short Links Manager",
      "short_name": "Short Links",
      "description": "Create and manage transparent 302 short links with QR codes and UTM builder",
      "url": "/links",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Chain Tracer API",
      "short_name": "API Docs",
      "description": "Developer JSON API documentation and interactive playground",
      "url": "/api-docs",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
